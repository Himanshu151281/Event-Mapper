<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top" aria-label="Main navigation">
  <div class="container-fluid">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/listings">
      <i class="fa-regular fa-compass" aria-hidden="true"></i>
      <span class="brand-text">Event Mapper</span>
    </a>
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
      aria-controls="navbarNavAltMarkup"
      aria-expanded="false"
      aria-label="Toggle navigation menu"
    >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse bg-white" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <a class="nav-link" href="/listings">Explore</a>
        <a class="nav-link" href="/listings/dashboard">Dashboard</a>
      </div>
      <div class="navbar-nav ms-auto">
        <!-- Submits to the events index, which filters on ?q= server-side.
             Previously this form had no action or field name and did nothing. -->
        <form class="d-flex" role="search" action="/listings" method="GET">
          <label class="visually-hidden" for="site-search">Search events</label>
          <input
            class="form-control me-2 search-inp"
            id="site-search"
            name="q"
            type="search"
            placeholder="Search events.."
            value="<%= typeof q !== 'undefined' ? q : '' %>"
          />
          <button class="btn search-btn" type="submit">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>Search
          </button>
        </form>
      </div>
      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/listings/new">Host Event</a>

        <% if(!currUser) {%>
        <a class="nav-link" href="/signup" rel="nofollow"><b>Sign up</b></a>
        <a class="nav-link" href="/login" rel="nofollow"><b>Log in</b></a>
        <% } %> <% if(currUser) {%>
        <a class="nav-link" href="/logout" rel="nofollow"><b>Log out</b></a>
        <% } %>
      </div>
    </div>
  </div>
</nav>
