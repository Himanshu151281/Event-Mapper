<% layout("/layouts/boilerplate") %>

<header class="mt-4">
  <% if (q) { %>
  <h1 class="h3 fw-bold">Events matching “<%= q %>”</h1>
  <p class="text-muted">
    <%= allListings.length %> result<%= allListings.length === 1 ? "" : "s" %> —
    <a href="/listings">clear search</a>
  </p>
  <% } else { %>
  <h1 class="h3 fw-bold">Discover events near you</h1>
  <p class="text-muted">
    Browse every event on Event Mapper, see where it is on the map and how many people are
    going — or <a href="/listings/new">host your own event</a>.
  </p>
  <% } %>
</header>

<% if (!allListings.length) { %>
<div class="py-5 text-center">
  <h2 class="h5">No events to show yet</h2>
  <p class="text-muted mb-3">
    <% if (q) { %>Nothing matched that search. <a href="/listings">Browse all events</a> instead.<%
    } else { %>Be the first to put an event on the map.<% } %>
  </p>
  <a class="btn btn-dark add-btn" href="/listings/new">Host an event</a>
</div>
<% } else { %>
<section class="row row-cols-lg-3 row-cols-md-2 row-cols-1 mt-3" aria-label="Events">
  <% allListings.forEach(function (listing, i) { %>
  <article class="col">
    <a href="/listings/<%= listing.slug || listing._id %>" class="listing-link">
      <div class="card listing-card">
        <img
          src="<%= optimizedImage(listing.image && listing.image.url, { width: 600, height: 400 }) %>"
          class="card-img-top"
          width="600"
          height="400"
          <%- i < 3 ? 'loading="eager" fetchpriority="high"' : 'loading="lazy"' %>
          decoding="async"
          alt="<%= listing.title %> — <%= listing.category %> event in <%= listing.location %>, <%= listing.country %>"
        />
        <div class="card-img-overlay"></div>
        <div class="card-body">
          <h2 class="h6 card-title mb-1"><%= listing.title %></h2>
          <p class="card-text mb-0">
            &#8377; <%= listing.price.toLocaleString("en-IN") %> /day
          </p>
          <p class="card-text text-muted small mb-0">
            <%= listing.location %> · <%= listing.date.toDateString() %>
          </p>
        </div>
      </div>
    </a>
  </article>
  <% }); %>
</section>
<% } %>
