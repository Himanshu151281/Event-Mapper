<% layout("/layouts/boilerplate") %>
<div class="row my-5">
  <div class="col-md-10 offset-md-1 col-lg-8 offset-lg-2">
    <h1 class="h3">
      <%= typeof statusCode !== "undefined" && statusCode === 404 ? "Page not found" : "Something went wrong" %>
    </h1>
    <div class="alert alert-danger" role="alert">
      <p class="mb-0"><%= message %></p>
    </div>
    <p>Try one of these instead:</p>
    <ul>
      <li><a href="/listings">Browse all events</a></li>
      <li><a href="/listings/dashboard">Filter events by category and date</a></li>
      <li><a href="/listings/new">Host your own event</a></li>
    </ul>
  </div>
</div>
