<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
  <div class="col-md-8 offset-md-2 col-lg-6 offset-lg-3">
    <h1 class="fw-bold mt-5 h3">Sign up on Event Mapper</h1>
    <form action="/signup" method="POST" class="needs-validation" novalidate>
      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input
          name="username"
          id="username"
          type="text"
          autocomplete="username"
          class="form-control"
          required
        />
        <div class="valid-feedback">Looks good!</div>
      </div>
      <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <input
          name="email"
          id="email"
          type="email"
          autocomplete="email"
          class="form-control"
          required
        />
      </div>
      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input
          name="password"
          id="password"
          type="password"
          autocomplete="new-password"
          class="form-control"
          required
        />
      </div>
      <button class="btn form-control text-white fw-bold btn-brand-dark">Sign up</button>
    </form>
    <p class="mt-3 mb-5">
      Already have an account? <a href="/login" rel="nofollow">Log in</a> or
      <a href="/listings">browse events</a>.
    </p>
  </div>
</div>
